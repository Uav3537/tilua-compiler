{
  "name": "@tilua/compiler",
  "version": "3.1.0",
  "description": "Compiles tilua to Luau: lowers the @tilua/parser AST to a luau-parser AST and prints it",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tilua": "dist/cli.js"
  },
  "files": [
    "dist",
    "runtime"
  ],
  "exports": {
    ".": {
      "types": {
        "require": "./dist/index.d.cts",
        "import": "./dist/index.d.ts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "test": "tsx scripts/test.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "tilua",
    "luau",
    "roblox",
    "compiler"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "luau-parser": "^1.0.3",
    "@tilua/parser": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Uav3537/tilua-compiler.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
